# Copy to .env.rds and keep it private. URL-encode reserved characters in URL passwords.
RDS_HOST=rds-private-hostname.example.internal
RDS_PORT=5432
RDS_DB=ticketing
RDS_USER=ticketing
RDS_PASSWORD=replace-with-raw-password-for-pgbouncer
RDS_SSLMODE=verify-full
RDS_CA_FILE=./secrets/rds-ca.pem

# Direct TLS connection for migrations, observers and the preflight.
RDS_MIGRATION_URL=postgresql://ticketing:URL_ENCODED_PASSWORD@rds-private-hostname.example.internal:5432/ticketing?sslmode=verify-full&connect_timeout=5

# Runtime processes connect to local PgBouncer. TLS terminates on the private Docker network;
# PgBouncer verifies the upstream RDS certificate using RDS_HOST and RDS_CA_FILE.
RDS_POOLED_DATABASE_URL=postgresql://ticketing:URL_ENCODED_PASSWORD@pgbouncer:5432/ticketing?connect_timeout=2

# Fixed comparison budgets. Do not raise these during the matched RDS test.
RDS_PGBOUNCER_POOL_SIZE=12
RDS_PGBOUNCER_MAX_CLIENT_CONN=160
RDS_PGBOUNCER_QUERY_WAIT_TIMEOUT=1

# Huawei DCS read/write endpoint. URL-encode reserved characters in the password.
# Never use the read-only endpoint for reservation intake.
DCS_REDIS_URL=redis://:URL_ENCODED_PASSWORD@dcs-read-write-hostname.example.internal:6379/0
RESERVATION_MODE=postgres
REDIS_RESERVATION_REPLICA_ACKS=1
REDIS_RESERVATION_WAIT_MS=100
REDIS_RESERVE_CONCURRENCY=128

# Opt-in reserved callback acquisition slots within the existing shared budget.
API_CALLBACK_ACQUISITION_RESERVE=0
