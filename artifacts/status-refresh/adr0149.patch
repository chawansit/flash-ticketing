+        assert conn.execute("SELECT count(*) AS n FROM tickets").fetchone()["n"] == 0
+        assert conn.execute("SELECT count(*) AS n FROM consumer_inbox WHERE event_id=%s", (envelope["event_id"],)).fetchone()["n"] == 0
