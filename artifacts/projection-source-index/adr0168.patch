+
+
+def test_legacy_source_index_migration_preserves_newer_rows(projection):
+    cache, event = projection
+    cache.put(event, 0, {"seats": [seat(i, 5, "SOLD") for i in range(513)]})
+    before = cache.read(event)
+    fields = [f"source:S{i}" for i in range(513)]
+    cache.redis.hdel(cache.key(event), *fields)
+    assert cache.put(event, 0, {"seats": [seat(i) for i in range(513)]}) == 2565
+    assert cache.read(event) == before
+    assert cache.redis.hmget(cache.key(event), fields) == ["5"] * 513
+    assert cache.patch(event, [seat(512, 6, "SOLD")])
+    assert cache.redis.hget(cache.key(event), "source:S512") == "6"
+    assert cache.read(event)["version"] == 2566
+
+
+def test_mixed_and_invalid_index_falls_back_to_existing_body(projection):
+    cache, event = projection
+    cache.put(event, 0, {"seats": [seat(i, 5, "SOLD") for i in range(257)]})
+    before = cache.read(event)
+    cache.redis.hdel(cache.key(event), "source:S0")
+    cache.redis.hset(cache.key(event), "source:S256", "invalid")
+    cache.put(event, 0, {"seats": [seat(i) for i in range(257)]})
+    assert cache.read(event) == before
+    assert cache.redis.hmget(cache.key(event), "source:S0", "source:S256") == ["5", "5"]
+
+
+def test_legacy_writer_namespace_cannot_invalidate_source_index(projection):
+    cache, event = projection
+    cache.put(event, 0, {"seats": [seat(0, 5, "SOLD")]})
+    before = cache.read(event)
+    legacy_key = f"seatmap:v2:{{{event}}}"
+    legacy_delta = f"seatdelta:v1:{{{event}}}"
+    try:
+        cache.redis.hset(legacy_key, mapping={"version": "99", "seat:S0": json.dumps(seat(0, 99))})
+        assert cache.key(event) != legacy_key
+        assert cache.delta_key(event) != legacy_delta
+        cache.put(event, 0, {"seats": [seat(0)]})
+        assert cache.read(event) == before
+        assert cache.redis.hget(cache.key(event), "source:S0") == "5"
+    finally:
+        cache.redis.delete(legacy_key, legacy_delta)
