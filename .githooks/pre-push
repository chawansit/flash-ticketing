#!/bin/sh
root=$(git rev-parse --show-toplevel) || exit 1
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$remote_ref" in
    refs/heads/codex/*) ;;
    *) echo "Standing envelope permits codex branches only; another destination requires approval." >&2; exit 1 ;;
  esac
  [ "$local_oid" = "0000000000000000000000000000000000000000" ] && {
    echo "Branch deletion is outside the standing publication envelope." >&2
    exit 1
  }
  sh "$root/.githooks/_python" --revision "$local_oid" || exit 1
done
