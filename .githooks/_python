#!/bin/sh
root=$(git rev-parse --show-toplevel) || exit 1
if [ -n "${REPOSITORY_NAMES_PYTHON:-}" ]; then
  exec "$REPOSITORY_NAMES_PYTHON" "$root/scripts/check_repository_names.py" "$@"
elif [ -x "$root/.venv/Scripts/python.exe" ]; then
  exec "$root/.venv/Scripts/python.exe" "$root/scripts/check_repository_names.py" "$@"
elif [ -x "$root/.venv/bin/python" ]; then
  exec "$root/.venv/bin/python" "$root/scripts/check_repository_names.py" "$@"
else
  exec python3 "$root/scripts/check_repository_names.py" "$@"
fi
