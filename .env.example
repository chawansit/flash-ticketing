ENVIRONMENT=development
JWT_SECRET=local-development-secret-change-me
WEBHOOK_SECRET=local-webhook-secret-change-me
HOLD_SECONDS=120
DB_POOL_MAX=12
RESERVE_CONCURRENCY=8
RESERVATION_MODE=postgres
REDIS_RESERVE_CONCURRENCY=128
REDIS_RESERVATION_REPLICA_ACKS=0
REDIS_RESERVATION_WAIT_MS=100
REDIS_RESERVATION_MAX_BACKLOG=10000

PUBLISHER_BATCH_SIZE=32
SIMULATOR_CONCURRENCY=4
REFRESH_COOLDOWN_MS=250

RECONCILE_INTERVAL_SECONDS=20
RECONCILE_WINDOW_SECONDS=300
RECONCILE_BATCH_SIZE=8
RECONCILE_BUDGET_MS=500
RECONCILE_LEASE_SECONDS=30
RECONCILE_BACKOFF_MS=1000
RECONCILE_SEED_BATCH=200

# Opt-in reserved callback acquisition slots within the existing shared budget.
API_CALLBACK_ACQUISITION_RESERVE=0

# Advisory order reads only; opt-in event refresh requires a positive cache age (max 3000 ms).
ORDER_STATUS_CACHE_MS=0
ORDER_STATUS_EVENT_REFRESH=0
ORDER_STATUS_EVENT_REFRESH_DEDUP=0

# Opt-in conservative release after partial native FIFO timeout pruning.
API_PARTIAL_TIMEOUT_RECLAIM=0
